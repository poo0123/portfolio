{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "page",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "LOG",
      "database_name": "poo123-log",
      "database_id": "71cc2e43-1a2e-47a9-9bb3-0c32571a1518"
    }
  ],
  "main": "src/worker.js"
}
